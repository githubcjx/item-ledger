.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}
.scroll { flex: 1; overflow: hidden; }

.search-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 12rpx 48rpx 16rpx;
  background: var(--card);
  border: 3rpx solid var(--accent);
  border-radius: 32rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 8rpx 28rpx rgba(224, 138, 82, 0.12);
}
.s-icon { line-height: 0; }
.s-input { flex: 1; font-size: 30rpx; color: var(--ink); }
.s-ph { color: #B3AA98; }
.s-clear {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-hint {
  font-size: 25rpx;
  color: var(--ink-soft);
  margin: 24rpx 0 20rpx;
}
.result-hint .hl { color: var(--accent-deep); font-weight: 700; }

.chip-row {
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

/* 段落标签右侧操作（清空） */
.label-action {
  order: 3;
  margin-left: 20rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--accent-deep);
  letter-spacing: 0;
}
.section-label::after { order: 2; }

/* 最近搜过 · 可删除的标签 */
.recent-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  padding: 12rpx 14rpx 12rpx 26rpx;
}
.recent-q {
  font-size: 26rpx;
  color: var(--ink-soft);
}
.recent-del {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
}
.recent-del:active { background: #E7DCC8; }

.tips { }
.tip {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
}
.tip-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.7;
}
.hl-ink { color: var(--ink); font-weight: 700; }

/* 溯源卡片 */
.trace-card {
  background: var(--card);
  border-radius: 36rpx;
  border: 1rpx solid var(--line);
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(58, 40, 24, 0.05);
}
.trace-card:active { transform: scale(0.99); }
.trace-item-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}
.trace-item-thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.kraft-soft { background: #F0DAC9; }
.ti-img { width: 100%; height: 100%; border-radius: 26rpx; }
.trace-item-main { flex: 1; min-width: 0; }
.trace-item-name { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.trace-item-match {
  font-size: 23rpx;
  color: var(--sage-deep);
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.trace-path {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 28rpx;
  border-top: 1rpx dashed var(--line);
}
.trace-path-step {
  flex: 1;
  text-align: center;
}
.tp-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 14rpx;
}
.tp-label {
  font-size: 23rpx;
  color: var(--ink);
  font-weight: 600;
  line-height: 1.4;
}
.trace-path-arrow {
  line-height: 0;
  margin-bottom: 36rpx;
}
