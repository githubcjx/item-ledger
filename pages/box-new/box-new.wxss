.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}
.scroll { flex: 1; overflow: hidden; }
.ph { color: #B5AD96; }

/* 表单步骤：用普通 view（非 scroll-view）承载输入框，规避原生 input 文字不显示的问题 */
.step-pad {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 40rpx 220rpx;
}
.step-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.step3-top {
  flex-shrink: 0;
  padding: 20rpx 40rpx 0;
}
.step3-grid {
  flex: 1;
  overflow: hidden;
  padding: 0 40rpx 120rpx;
}

.step-desc {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 32rpx;
  white-space: pre-wrap;
}

/* ---------- 拍摄舞台 ---------- */
.capture-stage {
  flex: 1;
  background: #15130F;
  margin: 16rpx 32rpx 24rpx;
  border-radius: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  min-height: 720rpx;
}
.captured-fill { position: absolute; inset: 0; width: 100%; height: 100%; }
.cfc { position: absolute; width: 56rpx; height: 56rpx; }
.cfc-tl { top: 48rpx; left: 48rpx; border-top: 6rpx solid var(--kraft); border-left: 6rpx solid var(--kraft); border-radius: 12rpx 0 0 0; }
.cfc-tr { top: 48rpx; right: 48rpx; border-top: 6rpx solid var(--kraft); border-right: 6rpx solid var(--kraft); border-radius: 0 12rpx 0 0; }
.cfc-bl { bottom: 48rpx; left: 48rpx; border-bottom: 6rpx solid var(--kraft); border-left: 6rpx solid var(--kraft); border-radius: 0 0 0 12rpx; }
.cfc-br { bottom: 48rpx; right: 48rpx; border-bottom: 6rpx solid var(--kraft); border-right: 6rpx solid var(--kraft); border-radius: 0 0 12rpx 0; }
.camera-hint {
  color: #C9BFA8;
  font-size: 27rpx;
  text-align: center;
  padding: 0 80rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.camera-hint .big { display: flex; justify-content: center; margin-bottom: 28rpx; opacity: 0.7; }
.capture-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-soft);
  padding-bottom: 20rpx;
}

/* ---------- 起名页头 ---------- */
.named-head {
  display: flex;
  gap: 28rpx;
  margin-bottom: 44rpx;
}
.nh-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.nh-emoji { font-size: 72rpx; position: relative; z-index: 1; }
.nh-img { width: 100%; height: 100%; border-radius: 28rpx; }
.nh-text {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  white-space: pre-wrap;
}

/* ---------- AI 识别按钮 ---------- */
.ai-recognize-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, var(--kraft), var(--kraft-deep));
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(168,130,79,0.3);
}
.ai-recognize-btn:active { transform: scale(0.99); }
.air-icon { line-height: 0; }
.air-text { flex: 1; }
.air-title { font-size: 30rpx; font-weight: 700; color: #fff; }
.air-sub { font-size: 22rpx; color: rgba(255,255,255,0.85); margin-top: 4rpx; }
.air-arrow { color: rgba(255,255,255,0.8); font-size: 36rpx; }

.or-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 24rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}
.or-divider::before,
.or-divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--line);
  margin: 0 20rpx;
}

/* ---------- 添加物品 ---------- */
.add-item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--white);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx;
  margin-bottom: 28rpx;
}
.ai-photo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--paper-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.ai-img { width: 100%; height: 100%; border-radius: 16rpx; }
.ai-input { flex: 1; font-size: 28rpx; color: var(--ink); }
.ai-add {
  flex-shrink: 0;
  background: var(--kraft-deep);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 30rpx;
  border-radius: 18rpx;
}
.ai-add.disabled { background: #C9C2AC; }

.items-count {
  font-size: 23rpx;
  color: var(--ink-soft);
  margin-bottom: 16rpx;
}
.items-empty {
  text-align: center;
  font-size: 25rpx;
  color: #ADA68F;
  padding: 60rpx 0;
}

.id-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.id-item {
  background: var(--white);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 20rpx;
  position: relative;
}
.id-thumb {
  position: relative;
  width: 100%;
  height: 152rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.id-cam {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(43, 38, 32, 0.55);
  border-radius: 14rpx 0 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.id-name { padding: 0 4rpx; }
.id-img { width: 100%; height: 100%; border-radius: 16rpx; }
.id-name { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.remove-x {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(43,38,32,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ink-soft);
  z-index: 2;
}

/* ---------- 位置照片 ---------- */
.loc-photo-box {
  width: 100%;
  height: 280rpx;
  border-radius: 28rpx;
  border: 3rpx dashed var(--line);
  background: var(--white);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  overflow: hidden;
  position: relative;
}
.loc-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.plus-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--paper-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.chip-row { display: flex; gap: 16rpx; flex-wrap: wrap; }

/* ---------- 兜底链接 / 行 ---------- */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.ghost-link {
  font-size: 23rpx;
  color: var(--kraft-deep);
  text-decoration: underline;
}
.ghost-link.center {
  display: block;
  text-align: center;
  margin: 24rpx 0 8rpx;
}

/* ---------- 两步识别·画框复核 ---------- */
.review-scroll {
  flex: 1;
  overflow: hidden;
  padding: 0 40rpx 120rpx;
}
.anno-hint {
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  padding: 16rpx 0;
}
.anno-wrap {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #15130F;
}
.anno-img { width: 100%; display: block; }
.anno-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.anno-box {
  position: absolute;
  border: 3rpx solid rgba(127, 224, 184, 0.9);
  background: rgba(127, 224, 184, 0.12);
  border-radius: 8rpx;
  box-sizing: border-box;
}
.anno-box.named {
  border-color: rgba(201, 168, 118, 0.95);
  background: rgba(201, 168, 118, 0.16);
}
.anno-box.selected {
  border-color: #FFFCF6;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.25);
}
.anno-no {
  position: absolute;
  top: 0;
  left: 0;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 8rpx 0 8rpx 0;
  background: rgba(43, 38, 32, 0.78);
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}
.anno-del {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(177, 75, 63, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}
.anno-name {
  position: absolute;
  left: -3rpx;
  bottom: -3rpx;
  max-width: calc(100% + 6rpx);
  font-size: 20rpx;
  line-height: 1.3;
  color: #fff;
  background: rgba(43, 38, 32, 0.78);
  padding: 3rpx 10rpx;
  border-radius: 8rpx 8rpx 8rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.anno-name.empty { background: rgba(127, 224, 184, 0.9); color: #15130F; }
.anno-name.naming { background: rgba(168, 130, 79, 0.92); }
.anno-draw {
  position: absolute;
  border: 3rpx dashed #7FE0B8;
  background: rgba(127, 224, 184, 0.15);
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 物品列表（review 态下方，可靠的命名/删除入口） */
.anno-empty {
  text-align: center;
  font-size: 24rpx;
  color: #ADA68F;
  padding: 40rpx 20rpx;
  line-height: 1.6;
}
.box-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.box-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx;
}
.br-thumb {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.br-img { width: 100%; height: 100%; }
.br-cam {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(43, 38, 32, 0.6);
  border-radius: 14rpx 0 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.br-no {
  position: absolute;
  top: 0;
  left: 0;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 16rpx 0 12rpx 0;
  background: rgba(43, 38, 32, 0.72);
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}
.br-main { flex: 1; min-width: 0; }
.br-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.br-name.muted { color: #ADA68F; font-weight: 500; }
.br-sub { font-size: 21rpx; color: var(--ink-soft); margin-top: 4rpx; }
.br-del {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(177, 75, 63, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 离屏裁剪画布 */
.cropper {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 10px;
  height: 10px;
}

/* ---------- AI 识别处理中遮罩 ---------- */
.processing-mask {
  position: fixed;
  inset: 0;
  background: rgba(242,238,228,0.96);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  z-index: 100;
}
.scan-box {
  width: 320rpx;
  height: 320rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #8a7251, #5c4a32);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
}
.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 6rpx;
  background: linear-gradient(90deg, transparent, #7FE0B8, transparent);
  box-shadow: 0 0 24rpx #7FE0B8;
  animation: scanmove 1.8s ease-in-out infinite;
}
@keyframes scanmove {
  0% { top: 0; }
  50% { top: 314rpx; }
  100% { top: 0; }
}
.dot-loader { display: flex; gap: 12rpx; }
.dot-loader view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--kraft-deep);
  animation: dotpulse 1.4s ease-in-out infinite;
}
.dot-loader view:nth-child(2) { animation-delay: 0.2s; }
.dot-loader view:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotpulse {
  0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.1); }
}
.processing-text { font-size: 28rpx; color: var(--ink-soft); }

/* ---------- 成功页 ---------- */
.success-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 60rpx;
}
.stamp-circle {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 8rpx solid var(--tag-green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 104rpx;
  color: var(--tag-green);
  transform: rotate(-8deg);
  animation: stampin 0.45s cubic-bezier(.2,1.4,.4,1);
}
@keyframes stampin {
  0% { transform: scale(2) rotate(-8deg); opacity: 0; }
  100% { transform: scale(1) rotate(-8deg); opacity: 1; }
}
.success-title { font-size: 36rpx; font-weight: 800; color: var(--ink); }
.success-sub {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.7;
  white-space: pre-wrap;
}
.success-card {
  width: 100%;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.sc-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.sc-emoji { font-size: 44rpx; position: relative; z-index: 1; }
.sc-img { width: 100%; height: 100%; border-radius: 20rpx; }
.sc-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.sc-name { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.sc-loc {
  font-size: 23rpx;
  color: var(--ink-soft);
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
