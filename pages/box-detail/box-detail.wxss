.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}
.scroll { flex: 1; overflow: hidden; margin-top: 12rpx; }

.icon-btn-sm {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
}

/* 封面 */
.box-hero {
  height: 352rpx;
  margin: 0 40rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  background: #E5D2C0;
}
.hero-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-cam {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(58, 50, 42, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.hero-label {
  background: rgba(255, 253, 247, 0.94);
  padding: 20rpx 30rpx;
  border-radius: 28rpx;
  position: relative;
  z-index: 1;
}
.hero-label .bn { font-size: 34rpx; font-weight: 800; color: var(--ink); }
.hero-label .bl { font-size: 23rpx; color: var(--ink-soft); margin-top: 4rpx; }

/* 位置条 */
.loc-strip {
  margin: 32rpx 40rpx 0;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
  box-shadow: 0 8rpx 28rpx rgba(58, 40, 24, 0.05);
}
.dl-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.dl-img { width: 100%; height: 100%; }
.dl-text { flex: 1; min-width: 0; }
.dl-title { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.dl-time {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.dl-action {
  font-size: 24rpx;
  color: var(--accent-deep);
  font-weight: 600;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.note-strip {
  margin: 22rpx 40rpx 0;
  background: var(--chip);
  border-radius: 26rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.note-txt {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

.items-tip {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin: -8rpx 0 16rpx;
}

/* 添加物品面板 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(58, 50, 42, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 48rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: xd-rise 0.32s cubic-bezier(0.22, 0.85, 0.3, 1) both;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 32rpx;
}
.sheet-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}
.add-photo {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 28rpx;
  border: 2rpx dashed var(--line);
  background: var(--card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  overflow: hidden;
}
.add-photo-img { width: 100%; height: 100%; }
.add-photo-tip { font-size: 20rpx; color: var(--ink-soft); }
.add-photo-clear {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(58, 50, 42, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-input {
  flex: 1;
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  height: 132rpx;
  padding: 0 30rpx;
  font-size: 29rpx;
  color: var(--ink);
}
.ph { color: #B3AA98; }
.sheet-actions { margin-top: 8rpx; }

/* 物品宫格 */
.items-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 22rpx;
}
.item-cell {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  padding: 18rpx;
  text-align: center;
}
.ic-thumb {
  width: 100%;
  height: 112rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
/* 占位缩略图 · 暖色柔光底循环（与设计稿一致） */
.item-cell:nth-child(5n+1) .ic-thumb { background: #EAD9CB; }
.item-cell:nth-child(5n+2) .ic-thumb { background: #DEE5D2; }
.item-cell:nth-child(5n+3) .ic-thumb { background: #F2D7C6; }
.item-cell:nth-child(5n+4) .ic-thumb { background: #ECE0C6; }
.item-cell:nth-child(5n+5) .ic-thumb { background: #E9D8C8; }
.ic-img { width: 100%; height: 100%; border-radius: 22rpx; }
.ic-name {
  font-size: 23rpx;
  color: var(--ink);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.items-empty {
  text-align: center;
  font-size: 25rpx;
  color: #B3AA98;
  line-height: 1.7;
  padding: 60rpx 40rpx;
  white-space: pre-wrap;
}
