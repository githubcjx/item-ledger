.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 28rpx;
  flex-shrink: 0;
}
.app-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}
.app-sub {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--white);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.scroll {
  flex: 1;
  overflow: hidden;
}

/* 搜索入口 */
.search-wrap {
  position: relative;
  margin-bottom: 36rpx;
}
.search-icon {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  line-height: 0;
}
.search-bar-fake {
  width: 100%;
  background: var(--white);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 26rpx 32rpx 26rpx 84rpx;
  font-size: 28rpx;
  color: #ADA68F;
}

/* 统计条 */
.stat-strip {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.stat-card {
  flex: 1;
  background: var(--white);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--line);
}
.stat-card .num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--kraft-deep);
  font-family: Georgia, "Times New Roman", serif;
}
.stat-card .lbl {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

/* 箱子卡片 */
.box-card {
  background: var(--white);
  border-radius: 32rpx;
  border: 1rpx solid var(--line);
  display: flex;
  gap: 26rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.box-card:active { transform: scale(0.985); }
.box-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.box-thumb::before {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(45deg, transparent, transparent 12rpx, rgba(0,0,0,0.04) 12rpx, rgba(0,0,0,0.04) 14rpx);
}
.thumb-emoji { font-size: 52rpx; position: relative; z-index: 1; }
.thumb-img { width: 100%; height: 100%; border-radius: 20rpx; }
.box-info { flex: 1; min-width: 0; }
.box-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding-right: 30rpx;
}
.box-loc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.box-items-preview {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.chevron {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  line-height: 0;
}

.demo-btn {
  margin-top: 16rpx;
  background: var(--white);
  border: 2rpx solid var(--kraft-deep);
  color: var(--kraft-deep);
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 40rpx;
  border-radius: 40rpx;
}

/* FAB */
.fab {
  position: fixed;
  bottom: 256rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--stamp-red);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 6rpx solid var(--paper);
  z-index: 30;
}

/* Tab bar */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(156rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(242,238,228,0.94);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: flex-start;
  padding-top: 20rpx;
  z-index: 25;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  color: var(--ink-soft);
}
.tab-item .ticon { line-height: 0; }
.tab-item.active { color: var(--kraft-deep); font-weight: 700; }
