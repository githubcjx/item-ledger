.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 48rpx 32rpx;
  flex-shrink: 0;
}
.app-title {
  font-size: 50rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.app-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}
.icon-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 30rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(58, 40, 24, 0.05);
}

.scroll {
  flex: 1;
  overflow: hidden;
}

/* 搜索入口 */
.search-wrap {
  position: relative;
  margin-bottom: 36rpx;
}
.search-icon {
  position: absolute;
  left: 34rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  line-height: 0;
}
.search-bar-fake {
  width: 100%;
  background: var(--card);
  border: 3rpx solid var(--line);
  border-radius: 34rpx;
  padding: 30rpx 32rpx 30rpx 92rpx;
  font-size: 29rpx;
  color: #B3AA98;
  box-shadow: 0 6rpx 24rpx rgba(58, 40, 24, 0.04);
}

/* 统计条 */
.stat-strip {
  display: flex;
  gap: 22rpx;
  margin-bottom: 8rpx;
}
.stat-card {
  flex: 1;
  background: var(--card);
  border-radius: 36rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid var(--line);
}
.stat-card .num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--accent-deep);
  line-height: 1;
}
.stat-card .lbl {
  font-size: 23rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
}

/* 箱子卡片 */
.box-card {
  background: var(--card);
  border-radius: 40rpx;
  border: 1rpx solid var(--line);
  display: flex;
  gap: 28rpx;
  padding: 28rpx;
  margin-bottom: 26rpx;
  position: relative;
  box-shadow: 0 8rpx 28rpx rgba(58, 40, 24, 0.05);
}
.box-card:active { transform: scale(0.985); }
.box-thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 34rpx;
  flex-shrink: 0;
}
.thumb-emoji { position: relative; z-index: 1; line-height: 0; }
.thumb-img { width: 100%; height: 100%; border-radius: 34rpx; }
.box-info { flex: 1; min-width: 0; }
.box-name {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding-right: 30rpx;
}
.box-loc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.box-items-preview {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.chevron {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  line-height: 0;
}

/* FAB — 圆角方块 · 赤陶橙 */
.fab {
  position: fixed;
  bottom: 220rpx;
  right: 48rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 40rpx;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid var(--bg);
  box-shadow: 0 24rpx 52rpx rgba(224, 138, 82, 0.46);
  z-index: 30;
}
.fab:active { transform: scale(0.94); }

/* Tab bar */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(244, 237, 226, 0.9);
  backdrop-filter: blur(28rpx);
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: flex-start;
  padding-top: 24rpx;
  z-index: 25;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
}
.tab-item .ticon { line-height: 0; }
.tab-item.active { color: var(--accent-deep); font-weight: 700; }
